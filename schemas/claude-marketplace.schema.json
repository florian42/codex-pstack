{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/florian42/codex-pstack/schemas/claude-plugin/marketplace.json",
  "title": "Claude Code Plugin Marketplace",
  "description": "Schema for .claude-plugin/marketplace.json — permissive to the fields Claude Code documents, strict about unknown keys.",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
      "description": "Unique marketplace identifier in kebab-case."
    },
    "owner": {
      "$ref": "#/$defs/person",
      "description": "The marketplace owner or organisation."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" }
      },
      "description": "Arbitrary metadata about the marketplace."
    },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pluginEntry" },
      "description": "Plugins this marketplace offers."
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string" }
      }
    },
    "pathOrPaths": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the plugin directory, or a shorthand remote reference."
        },
        {
          "type": "object",
          "required": ["source"],
          "additionalProperties": true,
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "Source kind discriminator, e.g. \"github\", \"git\", \"local\"."
            }
          },
          "description": "Structured source, discriminated by its own `source` field."
        }
      ]
    },
    "pluginEntry": {
      "type": "object",
      "required": ["name", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "description": "Plugin identifier matching the plugin's name in its plugin.json."
        },
        "source": { "$ref": "#/$defs/source" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "author": { "$ref": "#/$defs/person" },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "category": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "strict": {
          "type": "boolean",
          "description": "Whether missing components fail installation."
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "skills": { "$ref": "#/$defs/pathOrPaths" },
        "agents": { "$ref": "#/$defs/pathOrPaths" },
        "commands": { "$ref": "#/$defs/pathOrPaths" },
        "outputStyles": { "$ref": "#/$defs/pathOrPaths" },
        "hooks": {
          "oneOf": [{ "type": "string" }, { "type": "object" }]
        },
        "mcpServers": {
          "oneOf": [{ "type": "string" }, { "type": "object" }]
        },
        "lspServers": {
          "oneOf": [{ "type": "string" }, { "type": "object" }]
        }
      }
    }
  }
}
