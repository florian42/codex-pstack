{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/florian42/codex-pstack/schemas/codex-plugin/marketplace.json",
  "title": "Codex Plugin Marketplace",
  "description": "Schema for .agents/plugins/marketplace.json — the Codex marketplace that indexes the generated pstack distribution.",
  "type": "object",
  "required": ["name", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the marketplace."
    },
    "interface": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable marketplace name."
        }
      },
      "description": "Storefront presentation for the marketplace."
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/pluginEntry" },
      "description": "The single generated pstack entry."
    }
  },
  "$defs": {
    "pluginEntry": {
      "type": "object",
      "required": ["name", "source", "policy", "category"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "description": "Plugin identifier matching the plugin's name in its plugin.json."
        },
        "source": {
          "type": "object",
          "required": ["source", "path"],
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "local",
              "description": "The generated distribution is served from the repository itself."
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\./",
              "description": "Repository-relative path to the generated distribution."
            }
          }
        },
        "policy": {
          "type": "object",
          "required": ["installation", "authentication"],
          "additionalProperties": false,
          "properties": {
            "installation": { "const": "AVAILABLE" },
            "authentication": { "const": "ON_INSTALL" }
          }
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Marketplace category."
        },
        "description": { "type": "string" }
      }
    }
  }
}
